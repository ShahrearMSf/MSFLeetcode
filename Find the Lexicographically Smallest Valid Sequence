from typing import List

class Solution:
    def validSequence(self, word1: str, word2: str) -> List[int]:
        n = len(word1)
        m = len(word2)

        # suf[j] = the last occurrence in word1 that can be used
        # to match word2[j] while matching word2[j:] as a subsequence.
        last = [-1] * m

        i = n - 1
        j = m - 1

        while i >= 0 and j >= 0:
            if word1[i] == word2[j]:
                last[j] = i
                j -= 1
            i -= 1

        # Greedily construct the lexicographically smallest answer.
        ans = []
        j = 0
        used_change = False

        for i in range(n):
            if j == m:
                break

            # Exact match: always prefer it because i is the
            # smallest possible current index.
            if word1[i] == word2[j]:
                ans.append(i)
                j += 1

            # Use the one allowed modification.
            elif not used_change:
                # After choosing i as the mismatch, word2[j+1:]
                # must be matchable exactly after i.
                if j == m - 1 or last[j + 1] > i:
                    ans.append(i)
                    j += 1
                    used_change = True

        return ans if j == m else []
