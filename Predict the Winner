from typing import List

class Solution:
    def predictTheWinner(self, nums: List[int]) -> bool:
        n = len(nums)
        dp = nums[:]   # dp[i] = answer for interval starting at i

        for length in range(2, n + 1):
            for l in range(n - length + 1):
                r = l + length - 1
                dp[l] = max(nums[l] - dp[l + 1],
                            nums[r] - dp[l])

        return dp[0] >= 0
