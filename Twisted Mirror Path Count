class Solution:
    def uniquePaths(self, grid: List[List[int]]) -> int:
        MOD = 10**9 + 7
        m, n = len(grid), len(grid[0])

        dp = [0] * n

        for i in range(m):
            left = 0

            for j in range(n):
                above = dp[j]

                if i == 0 and j == 0:
                    ways = 1
                else:
                    ways = (left + above) % MOD

                if i == m - 1 and j == n - 1:
                    return ways

                if grid[i][j] == 1:
                    dp[j] = left
                    left = above
                else:
                    dp[j] = ways
                    left = ways

        return 0
